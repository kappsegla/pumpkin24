<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.pumpkin.controller.HelloController">
    <ListView prefHeight="200.0" prefWidth="200.0" items="${controller.model.messages}" />
    <TextField fx:id="textField" text="${controller.model.userText}"/>
    <Button fx:id="sendButton" disable="${textField.text.empty}" onAction="#sendAction" text="Skicka"/>
</VBox>
